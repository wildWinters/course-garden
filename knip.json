{
  "$schema": "https://unpkg.com/knip@4/schema.json",
  "entry": [
    "src/main.tsx",
    "src/**/*.stories.{ts,tsx}",
    "**/*.test.{ts,tsx}",
    "vite.config.ts",
    "postcss.config.js",
    "tailwind.config.js"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "ignore": [
    "**/*.d.ts",
    "**/*.test.{ts,tsx}",
    "**/*.spec.{ts,tsx}",
    "**/__mocks__/**",
    "**/__tests__/**",
    "**/test-utils/**",
    "**/dist/**",
    "**/build/**",
    "**/node_modules/**"
  ],
  "ignoreDependencies": [
    "@types/*",
    "eslint*",
    "jest*",
    "prettier*",
    "vite*",
    "typescript*",
    "postcss*",
    "tailwind*",
    "ts-node*",
    "ts-jest*"
  ],
  "ignoreBinaries": ["eslint", "prettier", "tsc", "vite"],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  }
}
